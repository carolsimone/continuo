FROM continuo-base:latest

# Install kubectl for e2e test port-forwarding (catalog is the
# in-cluster container the CI uses to drive e2e tests).
RUN ARCH=$(dpkg --print-architecture) && \
    curl -LO "https://dl.k8s.io/release/v1.30.0/bin/linux/${ARCH}/kubectl" && \
    chmod +x kubectl && mv kubectl /usr/local/bin/kubectl

WORKDIR /app

# Layer 1: Workspace stub. go.work and the go.mod / go.sum files of pkg,
# catalog and the other workspace modules listed below are copied;
# Layer 2 drops every module but pkg and catalog from the workspace, so
# only those two are built against and get their source trees later.
# Limiting the source-copy layers to the dirs this service actually
# touches means a change to execution-controller does not invalidate
# this image's cache.
COPY go.work go.work.sum* ./
COPY pkg/go.mod pkg/go.sum ./pkg/
COPY catalog/go.mod catalog/go.sum ./catalog/
COPY execution-controller/go.mod execution-controller/go.sum ./execution-controller/
COPY release-controller/go.mod release-controller/go.sum ./release-controller/
COPY tests/e2e/go.mod tests/e2e/go.sum ./tests/e2e/
COPY remediation/go.mod remediation/go.sum ./remediation/
COPY agent-remediation/go.mod agent-remediation/go.sum ./agent-remediation/
COPY dead-letter-controller/go.mod dead-letter-controller/go.sum ./dead-letter-controller/
COPY egress-proxy/go.mod egress-proxy/go.sum ./egress-proxy/

# Layer 2: Drop unused use-directives so `go build` does not require the
# other services' source trees to be present in this image.
RUN go work edit -dropuse=./run-controller \
    && go work edit -dropuse=./execution-controller \
    && go work edit -dropuse=./agent-chat \
    && go work edit -dropuse=./release-controller \
    && go work edit -dropuse=./remediation \
    && go work edit -dropuse=./agent-remediation \
    && go work edit -dropuse=./dead-letter-controller \
    && go work edit -dropuse=./egress-proxy \
    && go work edit -dropuse=./tests/e2e

# Layer 3: Download dependencies with cache mount.
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

# Layer 4: Source. pkg/ is a lower-churn dependency of catalog;
# catalog/ comes last so changes here do not invalidate the earlier
# layers.
COPY pkg/ ./pkg/
COPY catalog/ ./catalog/

WORKDIR /app/catalog

EXPOSE 8087 50052

CMD ["tail", "-f", "/dev/null"]
