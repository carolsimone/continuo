FROM continuo-base:latest

WORKDIR /app

# Layer 1: Workspace stub. All go.mod / go.sum files are copied so
# `go mod download` can satisfy every dependency cited by go.work, but
# only the modules this image builds against (pkg, k8s-controller) get
# their source trees later. Limiting the source-copy layers to the
# service-owned dirs means a change to another service does not
# invalidate this image's cache.
COPY go.work go.work.sum* ./
COPY state/go.mod state/go.sum ./state/
COPY pkg/go.mod pkg/go.sum ./pkg/
COPY orchestrator/go.mod orchestrator/go.sum ./orchestrator/
COPY executor-controller/go.mod executor-controller/go.sum ./executor-controller/
COPY k8s-controller/go.mod k8s-controller/go.sum ./k8s-controller/
COPY tests/e2e/go.mod tests/e2e/go.sum ./tests/e2e/

# Layer 2: Drop unused use-directives so `go build` does not require the
# other services' source trees to be present in this image.
RUN go work edit -dropuse=./state \
    && go work edit -dropuse=./orchestrator \
    && go work edit -dropuse=./executor-controller \
    && go work edit -dropuse=./tests/e2e

# Layer 3: Download dependencies with cache mount.
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

# Layer 4: Source for the modules this service builds against. pkg/ first
# (lower churn) so a change in k8s-controller/ does not invalidate the
# pkg layer.
COPY pkg/ ./pkg/
COPY k8s-controller/ ./k8s-controller/

# k8s-controller/test/testutil.go loads db/migration/k8s/V*.sql at test
# runtime via pkg/testmigrations.Apply, so the migrations must be present
# in the image. Mirrors state/Dockerfile.dev and executor-controller/Dockerfile.dev.
COPY db/migration/k8s/ ./db/migration/k8s/

WORKDIR /app/k8s-controller

# Pre-compile the binary for faster startup in K8s.
RUN go build -o /app/k8s-controller/bin/k8s-controller main.go

EXPOSE 8085

CMD ["tail", "-f", "/dev/null"]
