# Build stage
FROM carolsimone/continuo-base:latest AS builder

WORKDIR /app

# Copy workspace and all go.mod files (required by go.work)
COPY go.work go.work.sum* ./
COPY state/go.mod state/go.sum ./state/
COPY pkg/go.mod pkg/go.sum ./pkg/
COPY orchestrator/go.mod orchestrator/go.sum ./orchestrator/
COPY executor-controller/go.mod executor-controller/go.sum ./executor-controller/
COPY k8s-controller/go.mod k8s-controller/go.sum ./k8s-controller/
COPY e2e/go.mod e2e/go.sum ./e2e/

# Download dependencies with cache
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

# Copy source code
COPY state/ ./state/
COPY pkg/ ./pkg/

# Build static binary
WORKDIR /app/state
RUN --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o /app/bin/state .

# Runtime stage
FROM alpine:latest

RUN apk --no-cache add ca-certificates tzdata

COPY --from=builder /app/bin/state /usr/local/bin/state

EXPOSE 8082 50051

CMD ["state"]
