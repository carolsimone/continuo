FROM continuo-base:latest

WORKDIR /app

# Layer 1: Workspace stub. All go.mod / go.sum files are copied so
# `go mod download` can satisfy every dependency cited by go.work, but
# only the modules this image builds against (pkg, state) get their
# source trees later. Limiting the source-copy layers to the service-
# owned dirs means a change to another service does not invalidate this
# image's cache.
COPY go.work go.work.sum* ./
COPY state/go.mod state/go.sum ./state/
COPY pkg/go.mod pkg/go.sum ./pkg/
COPY orchestrator/go.mod orchestrator/go.sum ./orchestrator/
COPY executor-controller/go.mod executor-controller/go.sum ./executor-controller/
COPY k8s-controller/go.mod k8s-controller/go.sum ./k8s-controller/
COPY tests/e2e/go.mod tests/e2e/go.sum ./tests/e2e/

# Layer 2: Drop unused use-directives so `go build` does not require the
# other services' source trees to be present in this image.
RUN go work edit -dropuse=./orchestrator \
    && go work edit -dropuse=./executor-controller \
    && go work edit -dropuse=./k8s-controller \
    && go work edit -dropuse=./tests/e2e

# Layer 3: Download dependencies with cache mount. Cache persists across
# builds; rebuild only re-runs when go.mod files change.
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

# Layer 4: Source for the modules this service builds against. pkg/ first
# (lower churn) so a change in state/ does not invalidate the pkg layer.
COPY pkg/ ./pkg/
COPY state/ ./state/

# state/test/migrations.go loads db/migration/state/V*.sql at test runtime
# so the in-container integration tests apply the same Flyway DDL as
# production.
COPY db/migration/state/ ./db/migration/state/

WORKDIR /app/state

EXPOSE 8082

CMD ["tail", "-f", "/dev/null"]
