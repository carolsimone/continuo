# Build stage
ARG BASE_IMAGE=ghcr.io/carolsimone/continuo-base:v1
FROM ${BASE_IMAGE} AS builder

WORKDIR /app

# Copy workspace and all go.mod files (required by go.work)
COPY go.work go.work.sum* ./
COPY agent-runner/go.mod agent-runner/go.sum ./agent-runner/
COPY pkg/go.mod pkg/go.sum ./pkg/
COPY orchestrator/go.mod orchestrator/go.sum ./orchestrator/
COPY executor-controller/go.mod executor-controller/go.sum ./executor-controller/
COPY k8s-controller/go.mod k8s-controller/go.sum ./k8s-controller/
COPY release-controller/go.mod release-controller/go.sum ./release-controller/
COPY state/go.mod state/go.sum ./state/
COPY tests/e2e/go.mod tests/e2e/go.sum ./tests/e2e/
COPY remediation/go.mod remediation/go.sum ./remediation/
COPY remediation-agent/go.mod remediation-agent/go.sum ./remediation-agent/

# Download dependencies with cache
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

# Copy source code
COPY agent-runner/ ./agent-runner/
COPY pkg/ ./pkg/

# Build the service binary
WORKDIR /app/agent-runner
RUN --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o /app/bin/agent-runner .

# Build the continuo CLI binary. The CLI is a separate Go module outside
# go.work and is compiled independently here so it is available on PATH in
# the runtime image for the catalog-load exec at agent startup.
WORKDIR /app
COPY cli/ ./cli/
# The CLI is its own module, deliberately excluded from /app/go.work. Building it
# while the workspace is active fails ("not one of the workspace modules"), so
# disable workspace mode for this standalone build.
RUN --mount=type=cache,target=/root/.cache/go-build \
    cd /app/cli && GOWORK=off CGO_ENABLED=0 GOOS=linux go build -o /app/bin/continuo ./cmd/continuo

# Runtime stage
FROM alpine:latest

RUN apk --no-cache add ca-certificates tzdata

# Explicit COPY allowlist — only these two binaries; new top-level builder
# artifacts are silently absent from the runtime image unless added here.
COPY --from=builder /app/bin/agent-runner /usr/local/bin/agent-runner
COPY --from=builder /app/bin/continuo /usr/local/bin/continuo

EXPOSE 8091 50053

# Static binary; no filesystem writes at runtime — run unprivileged.
USER 65532:65532

CMD ["agent-runner"]
