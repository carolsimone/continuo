user default on >continuo ~* &* +@all
user continuo_agent_chat on >local-continuo_agent_chat ~continuo:agent-chat:ratelimit:* -@all +ping +hello +client|setinfo +xinfo|groups +eval +evalsha +zremrangebyscore +zcard +zadd +pexpire
user continuo_agent_remediation on >local-continuo_agent_remediation ~continuo:remediation.requested:v2 %W~continuo:consumer.dead_letter:v1 %W~continuo:outbox.dead_letter:v1 %W~continuo:remediation.pr_closed:v1 %W~continuo:remediation.pr_opened:v1 %W~continuo:remediation.proposed:v1 ~continuo:llmcache:* ~remediation.requested:v2 %W~consumer.dead_letter:v1 %W~outbox.dead_letter:v1 %W~remediation.pr_closed:v1 %W~remediation.pr_opened:v1 %W~remediation.proposed:v1 -@all +ping +hello +client|setinfo +xinfo|groups +xadd +xreadgroup +xack +xautoclaim +xclaim +xpending +xinfo|consumers +xgroup|delconsumer +get +set
user continuo_catalog on >local-continuo_catalog ~continuo:release.promoted:v2 ~continuo:remediation.pr_closed:v1 ~continuo:remediation.pr_opened:v1 ~continuo:remediation.requested:v2 %W~continuo:consumer.dead_letter:v1 ~release.promoted:v2 ~remediation.pr_closed:v1 ~remediation.pr_opened:v1 ~remediation.requested:v2 %W~consumer.dead_letter:v1 -@all +ping +hello +client|setinfo +xinfo|groups +xadd +xreadgroup +xack +xautoclaim +xclaim +xpending +xinfo|consumers +xgroup|delconsumer
user continuo_dead_letter_controller on >local-continuo_dead_letter_controller ~continuo:* ~check.k8s:v1 ~compile.completed:v1 ~compile.node.completed:v1 ~compile.requested:v1 ~consumer.dead_letter:v1 ~initialize.run:v1 ~manifest.loaded.candidate:v1 ~manifest.loaded.candidate:v2 ~manifest.loaded:v1 ~node.deployed:v1 ~node.updated:v1 ~outbox.dead_letter:v1 ~pipeline.run.finished:v1 ~query.model:v1 ~release.promoted:v1 ~release.promoted:v2 ~release.rejected:v1 ~release.requested:v1 ~release.seeds.pending:v1 ~remediation.pr_closed:v1 ~remediation.pr_opened:v1 ~remediation.proposed:v1 ~remediation.requested:v1 ~remediation.requested:v2 ~remediation.retry_requested:v1 ~rerun.ready:v1 ~retry.task:v1 ~run.cancelled:v1 ~run.entries.dispatch_failed:v1 ~run.entries.dispatched:v1 ~run.finalized:v1 ~run.initialized:v1 ~schedule.cancelled:v1 ~scheduler.started:v1 ~schedules.loaded:v1 ~seed.build.completed:v1 ~seed.build.node.completed:v1 ~seed.build.requested:v1 ~task.dispatch:v1 ~task.execution.recorded:v1 ~task.failed:v1 ~task.status.updated:v1 ~task.status.updated:v2 ~trigger.promoted_seeds:v1 ~trigger.rebase:v1 ~trigger.rerun:v1 ~trigger.single_node_run:v1 ~update.graph:v1 ~validation.completed:v1 ~validation.node.completed:v1 ~validation.requested:v1 ~validation.result:v1 -@all +ping +hello +client|setinfo +xinfo|groups +xadd +xreadgroup +xack +xautoclaim +xclaim +xpending +xinfo|consumers +xgroup|delconsumer +xrange +xtrim +xlen +del +info
user continuo_execution_controller on >local-continuo_execution_controller ~continuo:compile.requested:v1 ~continuo:pipeline.run.finished:v1 ~continuo:release.promoted:v2 ~continuo:release.rejected:v1 ~continuo:run.cancelled:v1 ~continuo:seed.build.requested:v1 ~continuo:task.dispatch:v1 ~continuo:validation.requested:v1 ~continuo:validation.result:v1 %W~continuo:compile.completed:v1 %W~continuo:consumer.dead_letter:v1 %W~continuo:outbox.dead_letter:v1 %W~continuo:seed.build.completed:v1 %W~continuo:task.status.updated:v2 ~compile.requested:v1 ~pipeline.run.finished:v1 ~release.promoted:v2 ~release.rejected:v1 ~run.cancelled:v1 ~seed.build.requested:v1 ~task.dispatch:v1 ~validation.requested:v1 ~validation.result:v1 %W~compile.completed:v1 %W~consumer.dead_letter:v1 %W~outbox.dead_letter:v1 %W~seed.build.completed:v1 %W~task.status.updated:v2 -@all +ping +hello +client|setinfo +xinfo|groups +xadd +xreadgroup +xack +xautoclaim +xclaim +xpending +xinfo|consumers +xgroup|delconsumer
user continuo_release_controller on >local-continuo_release_controller ~continuo:compile.completed:v1 ~continuo:manifest.loaded.candidate:v2 ~continuo:seed.build.completed:v1 ~continuo:validation.result:v1 %W~continuo:compile.requested:v1 %W~continuo:consumer.dead_letter:v1 %W~continuo:outbox.dead_letter:v1 %W~continuo:pipeline.run.finished:v1 %W~continuo:release.promoted:v2 %W~continuo:release.rejected:v1 %W~continuo:release.requested:v1 %W~continuo:remediation.retry_requested:v1 %W~continuo:seed.build.requested:v1 %W~continuo:validation.requested:v1 ~compile.completed:v1 ~manifest.loaded.candidate:v2 ~seed.build.completed:v1 ~validation.result:v1 %W~compile.requested:v1 %W~consumer.dead_letter:v1 %W~outbox.dead_letter:v1 %W~pipeline.run.finished:v1 %W~release.promoted:v2 %W~release.rejected:v1 %W~release.requested:v1 %W~remediation.retry_requested:v1 %W~seed.build.requested:v1 %W~validation.requested:v1 -@all +ping +hello +client|setinfo +xinfo|groups +xadd +xreadgroup +xack +xautoclaim +xclaim +xpending +xinfo|consumers +xgroup|delconsumer
user continuo_remediation on >local-continuo_remediation ~continuo:release.rejected:v1 ~continuo:remediation.retry_requested:v1 %W~continuo:consumer.dead_letter:v1 %W~continuo:outbox.dead_letter:v1 %W~continuo:remediation.requested:v2 ~release.rejected:v1 ~remediation.retry_requested:v1 %W~consumer.dead_letter:v1 %W~outbox.dead_letter:v1 %W~remediation.requested:v2 -@all +ping +hello +client|setinfo +xinfo|groups +xadd +xreadgroup +xack +xautoclaim +xclaim +xpending +xinfo|consumers +xgroup|delconsumer
user continuo_run_controller on >local-continuo_run_controller ~continuo:release.promoted:v2 ~continuo:task.status.updated:v2 %W~continuo:consumer.dead_letter:v1 %W~continuo:outbox.dead_letter:v1 %W~continuo:run.cancelled:v1 %W~continuo:task.dispatch:v1 ~release.promoted:v2 ~task.status.updated:v2 %W~consumer.dead_letter:v1 %W~outbox.dead_letter:v1 %W~run.cancelled:v1 %W~task.dispatch:v1 -@all +ping +hello +client|setinfo +xinfo|groups +xadd +xreadgroup +xack +xautoclaim +xclaim +xpending +xinfo|consumers +xgroup|delconsumer
user continuo_redis_migrate on >local-continuo_redis_migrate ~continuo:* -@all +ping +hello +client|setinfo +xgroup|create +xgroup|destroy +xinfo|groups +exists +type
user continuo_topology_controller on >local-continuo_topology_controller ~continuo:release.requested:v1 %W~continuo:consumer.dead_letter:v1 %W~continuo:manifest.loaded.candidate:v2 ~release.requested:v1 %W~consumer.dead_letter:v1 %W~manifest.loaded.candidate:v2 -@all +ping +hello +client|setinfo +xinfo|groups +xadd +xreadgroup +xack +xautoclaim +xclaim +xpending +xinfo|consumers +xgroup|delconsumer
user continuo_ui on >local-continuo_ui ~continuo:uisession:* -@all +ping +hello +client|setinfo +xinfo|groups +get +set +del +expire
