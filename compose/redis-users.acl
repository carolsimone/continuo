user default on >continuo ~* &* +@all
user continuo_agent_chat on >local-continuo_agent_chat ~continuo:agent-chat:ratelimit:* -@all +ping +hello +client|setinfo +xinfo|groups +eval +evalsha +zremrangebyscore +zcard +zadd +pexpire
user continuo_agent_remediation on >local-continuo_agent_remediation ~continuo:remediation.requested:v2 %W~continuo:consumer.dead_letter:v1 %W~continuo:outbox.dead_letter:v1 %W~continuo:remediation.pr_closed:v1 %W~continuo:remediation.pr_opened:v1 %W~continuo:remediation.proposed:v1 ~continuo:llmcache:* -@all +ping +hello +client|setinfo +xinfo|groups +xadd +xreadgroup +xack +xautoclaim +xclaim +xpending +xinfo|consumers +xgroup|delconsumer +get +set
user continuo_catalog on >local-continuo_catalog ~continuo:release.promoted:v2 ~continuo:remediation.pr_closed:v1 ~continuo:remediation.pr_opened:v1 ~continuo:remediation.requested:v2 %W~continuo:consumer.dead_letter:v1 -@all +ping +hello +client|setinfo +xinfo|groups +xadd +xreadgroup +xack +xautoclaim +xclaim +xpending +xinfo|consumers +xgroup|delconsumer
user continuo_dead_letter_controller on >local-continuo_dead_letter_controller ~continuo:* -@all +ping +hello +client|setinfo +xinfo|groups +xadd +xreadgroup +xack +xautoclaim +xclaim +xpending +xinfo|consumers +xgroup|delconsumer +xrange +xtrim +xlen +del +info
user continuo_execution_controller on >local-continuo_execution_controller ~continuo:compile.requested:v1 ~continuo:pipeline.run.finished:v1 ~continuo:release.promoted:v2 ~continuo:release.rejected:v1 ~continuo:run.cancelled:v1 ~continuo:seed.build.requested:v1 ~continuo:task.dispatch:v1 ~continuo:validation.requested:v1 ~continuo:validation.result:v1 %W~continuo:compile.completed:v1 %W~continuo:consumer.dead_letter:v1 %W~continuo:outbox.dead_letter:v1 %W~continuo:seed.build.completed:v1 %W~continuo:task.status.updated:v2 -@all +ping +hello +client|setinfo +xinfo|groups +xadd +xreadgroup +xack +xautoclaim +xclaim +xpending +xinfo|consumers +xgroup|delconsumer
user continuo_release_controller on >local-continuo_release_controller ~continuo:compile.completed:v1 ~continuo:manifest.loaded.candidate:v2 ~continuo:seed.build.completed:v1 ~continuo:validation.result:v1 %W~continuo:compile.requested:v1 %W~continuo:consumer.dead_letter:v1 %W~continuo:outbox.dead_letter:v1 %W~continuo:pipeline.run.finished:v1 %W~continuo:release.promoted:v2 %W~continuo:release.rejected:v1 %W~continuo:release.requested:v1 %W~continuo:remediation.retry_requested:v1 %W~continuo:seed.build.requested:v1 %W~continuo:validation.requested:v1 -@all +ping +hello +client|setinfo +xinfo|groups +xadd +xreadgroup +xack +xautoclaim +xclaim +xpending +xinfo|consumers +xgroup|delconsumer
user continuo_remediation on >local-continuo_remediation ~continuo:release.rejected:v1 ~continuo:remediation.retry_requested:v1 %W~continuo:consumer.dead_letter:v1 %W~continuo:outbox.dead_letter:v1 %W~continuo:remediation.requested:v2 -@all +ping +hello +client|setinfo +xinfo|groups +xadd +xreadgroup +xack +xautoclaim +xclaim +xpending +xinfo|consumers +xgroup|delconsumer
user continuo_run_controller on >local-continuo_run_controller ~continuo:release.promoted:v2 ~continuo:task.status.updated:v2 %W~continuo:consumer.dead_letter:v1 %W~continuo:outbox.dead_letter:v1 %W~continuo:run.cancelled:v1 %W~continuo:task.dispatch:v1 -@all +ping +hello +client|setinfo +xinfo|groups +xadd +xreadgroup +xack +xautoclaim +xclaim +xpending +xinfo|consumers +xgroup|delconsumer
user continuo_redis_migrate on >local-continuo_redis_migrate ~continuo:* -@all +ping +hello +client|setinfo +xgroup|create +xgroup|destroy +xinfo|groups +exists
user continuo_topology_controller on >local-continuo_topology_controller ~continuo:release.requested:v1 %W~continuo:consumer.dead_letter:v1 %W~continuo:manifest.loaded.candidate:v2 -@all +ping +hello +client|setinfo +xinfo|groups +xadd +xreadgroup +xack +xautoclaim +xclaim +xpending +xinfo|consumers +xgroup|delconsumer
user continuo_ui on >local-continuo_ui ~continuo:uisession:* -@all +ping +hello +client|setinfo +xinfo|groups +get +set +del +expire
