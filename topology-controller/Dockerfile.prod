# uv comes from its official image, pinned by digest. That image ships uv's
# statically linked musl build, which runs under QEMU's amd64 emulation: the
# arm64 CI runners build this image's linux/amd64 half that way, and uv's glibc
# build (what `pip install uv` installs) crashes at start under QEMU 9 and later.
FROM ghcr.io/astral-sh/uv:0.13.5@sha256:32a7bb39b496babbd997b0a39a4d66c126bdaf5661b302bf6f06abda8deca6ff AS uv

FROM python:3.14-slim AS builder

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=uv /uv /usr/local/bin/uv

# Resolve dependencies from the lockfile, never from versions named here: the
# declared set in pyproject.toml/uv.lock is what CI tests, so anything pinned in
# this file would ship a set no test ever exercised. Guarded by
# tests/test_prod_image_guard.py.
COPY pyproject.toml uv.lock ./

ENV UV_PROJECT_ENVIRONMENT=/app/.venv

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project

COPY main.py ./
COPY streams_contract.py ./
COPY config/ ./config/
COPY adapters/ ./adapters/
COPY domain/ ./domain/
COPY service/ ./service/
COPY proto/ ./proto/

FROM python:3.14-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app/main.py ./
COPY --from=builder /app/streams_contract.py ./
COPY --from=builder /app/config/ ./config/
COPY --from=builder /app/adapters/ ./adapters/
COPY --from=builder /app/domain/ ./domain/
COPY --from=builder /app/service/ ./service/
COPY --from=builder /app/proto/ ./proto/

ENV PATH="/app/.venv/bin:$PATH"

RUN useradd --uid 65532 --no-create-home --shell /usr/sbin/nologin nonroot

# Reads code from the image, writes only to stdout — run unprivileged.
USER 65532:65532

EXPOSE 8086

CMD ["python", "main.py"]
