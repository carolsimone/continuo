# The image is built for linux/amd64 and linux/arm64 from a runner of one
# architecture, and no step of it runs under CPU emulation: the uv and builder
# stages run on the build platform, the builder installs the target platform's
# wheels, and the runtime stage only copies files. Guarded by
# tests/test_prod_image_cross_build_guard.py.

# uv comes from its official image, pinned by digest.
FROM --platform=$BUILDPLATFORM ghcr.io/astral-sh/uv:0.13.7@sha256:96f40d3904aad8d0bd010539001d36c8e2188b981e1334471a90c4a1d93bb490 AS uv

# The same python image as the runtime stage, so the venv's interpreter
# (/usr/local/bin/python3) is the one the runtime stage provides.
FROM --platform=$BUILDPLATFORM python:3.14-slim@sha256:9aaa474097d094040649f2162a627c0049b408f52138d980916788d80f04802f AS builder

ARG TARGETARCH

WORKDIR /app

COPY --from=uv /uv /usr/local/bin/uv

# Resolve dependencies from the lockfile, never from versions named here: the
# declared set in pyproject.toml/uv.lock is what CI tests, so anything pinned in
# this file would ship a set no test ever exercised. Guarded by
# tests/test_prod_image_guard.py.
COPY pyproject.toml uv.lock ./

ENV UV_PROJECT_ENVIRONMENT=/app/.venv \
    UV_PYTHON_DOWNLOADS=never

# --python-platform installs the wheels of the target platform, whatever this
# stage runs on. --no-build refuses a package with no wheel for it: uv would
# build that package for the build platform, not for the target.
RUN --mount=type=cache,target=/root/.cache/uv \
    case "${TARGETARCH}" in \
      amd64) python_platform=x86_64-manylinux_2_28 ;; \
      arm64) python_platform=aarch64-manylinux_2_28 ;; \
      *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && uv sync --frozen --no-dev --no-install-project --no-build \
         --python-platform "${python_platform}"

FROM python:3.14-slim@sha256:9aaa474097d094040649f2162a627c0049b408f52138d980916788d80f04802f

WORKDIR /app

COPY --from=builder /app/.venv /app/.venv
COPY main.py ./
COPY streams_contract.py ./
COPY config/ ./config/
COPY adapters/ ./adapters/
COPY domain/ ./domain/
COPY service/ ./service/
COPY proto/ ./proto/

ENV PATH="/app/.venv/bin:$PATH"

# Reads code from the image, writes only to stdout — run unprivileged. A
# numeric user needs no /etc/passwd entry, so this stage runs no command.
USER 65532:65532

EXPOSE 8086

CMD ["python", "main.py"]
