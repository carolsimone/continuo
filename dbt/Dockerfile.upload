FROM dbt-base:latest

# Clear the inherited dbt-base entrypoint; callers use docker exec with explicit commands
ENTRYPOINT []

WORKDIR /app

RUN pip install --no-cache-dir uv

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen

COPY dbt_upload/ ./dbt_upload/
COPY targets.yaml .
# Kept so integration tests can be run via: docker exec dbt-compile-and-load uv run --with pytest pytest tests/
COPY tests/ ./tests/
# NOTE: compile_uploader.py is copied here for TEST/integration harness use only
# (run via `docker exec dbt-compile-and-load pytest`). In PRODUCTION the compile
# Job's upload container is the dedicated manifest-uploader image (python+boto3,
# no dbt), keeping S3 access entirely out of any dbt image. The dbt+uploader
# co-residence in this image is test-only and does not violate production isolation.
COPY manifest-uploader/compile_uploader.py /compile_uploader.py

CMD ["tail", "-f", "/dev/null"]
