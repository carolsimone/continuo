FROM dbt-base:latest

# Clear the inherited dbt-base entrypoint; callers use docker exec with explicit commands
ENTRYPOINT []

WORKDIR /app

RUN pip install uv --quiet

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen

COPY dbt_upload/ ./dbt_upload/
COPY targets.yaml .
COPY tests/ ./tests/

CMD ["tail", "-f", "/dev/null"]
