FROM dbt-base:latest

# wise-dbt is a dbt alias exercising the dbt-commands.yaml dialect path in
# e2e: the executor dispatches service-1 jobs as `wise-dbt run --select ...`.
RUN ln -s "$(command -v dbt)" /usr/local/bin/wise-dbt

COPY dbt_project.yml profiles.yml ./
COPY models/ ./models/
COPY seeds/ ./seeds/
COPY snapshots/ ./snapshots/
