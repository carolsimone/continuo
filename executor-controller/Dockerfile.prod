# Build stage
FROM carolsimone/continuo-base:latest AS builder

WORKDIR /app

# Copy workspace and all go.mod files (required by go.work)
COPY go.work go.work.sum* ./
COPY state/go.mod state/go.sum ./state/
COPY pkg/go.mod pkg/go.sum ./pkg/
COPY orchestrator/go.mod orchestrator/go.sum ./orchestrator/
COPY executor-controller/go.mod executor-controller/go.sum ./executor-controller/
COPY k8s-controller/go.mod k8s-controller/go.sum ./k8s-controller/
COPY release-controller/go.mod release-controller/go.sum ./release-controller/
COPY tests/e2e/go.mod tests/e2e/go.sum ./tests/e2e/

# Download dependencies with cache
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

# Copy source code
COPY executor-controller/ ./executor-controller/
COPY pkg/ ./pkg/
COPY state/ ./state/

# Build static binary
WORKDIR /app/executor-controller
RUN --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o /app/bin/executor-controller .

# Runtime stage
FROM alpine:latest

RUN apk --no-cache add ca-certificates tzdata

COPY --from=builder /app/bin/executor-controller /usr/local/bin/executor-controller

EXPOSE 8084

CMD ["executor-controller"]
