ARG BASE_IMAGE=ghcr.io/carolsimone/continuo-base:v1
FROM --platform=$BUILDPLATFORM ${BASE_IMAGE} AS builder

# Supplied by buildx: the architecture of the image being produced. The builder
# itself stays on the native build platform and cross-compiles to it.
ARG TARGETARCH

WORKDIR /app

COPY go.work go.work.sum* ./
COPY state/go.mod state/go.sum ./state/
COPY pkg/go.mod pkg/go.sum ./pkg/
COPY orchestrator/go.mod orchestrator/go.sum ./orchestrator/
COPY executor-controller/go.mod executor-controller/go.sum ./executor-controller/
COPY k8s-controller/go.mod k8s-controller/go.sum ./k8s-controller/
COPY release-controller/go.mod release-controller/go.sum ./release-controller/
COPY tests/e2e/go.mod tests/e2e/go.sum ./tests/e2e/
COPY agent-chat/go.mod agent-chat/go.sum ./agent-chat/
COPY remediation/go.mod remediation/go.sum ./remediation/
COPY remediation-agent/go.mod remediation-agent/go.sum ./remediation-agent/

RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY release-controller/ ./release-controller/
COPY pkg/ ./pkg/

WORKDIR /app/release-controller
RUN --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux GOARCH=$TARGETARCH go build -a -installsuffix cgo -o /app/bin/release-controller .

RUN --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux GOARCH=$TARGETARCH go build -a -installsuffix cgo -o /app/bin/seed-service-prod ./cmd/seed-service-prod

FROM alpine:latest

RUN apk --no-cache add ca-certificates tzdata

COPY --from=builder /app/bin/release-controller /usr/local/bin/release-controller
COPY --from=builder /app/bin/seed-service-prod /usr/local/bin/seed-service-prod

EXPOSE 8088

# Static binary; no filesystem writes at runtime — run unprivileged.
USER 65532:65532

CMD ["release-controller"]
