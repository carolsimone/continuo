FROM continuo-base:latest

WORKDIR /app

COPY go.work go.work.sum* ./
COPY state/go.mod state/go.sum ./state/
COPY pkg/go.mod pkg/go.sum ./pkg/
COPY orchestrator/go.mod orchestrator/go.sum ./orchestrator/
COPY execution-controller/go.mod execution-controller/go.sum ./execution-controller/
COPY release-controller/go.mod release-controller/go.sum ./release-controller/
COPY tests/e2e/go.mod tests/e2e/go.sum ./tests/e2e/
COPY remediation/go.mod remediation/go.sum ./remediation/
COPY agent-remediation/go.mod agent-remediation/go.sum ./agent-remediation/
COPY dead-letter-controller/go.mod dead-letter-controller/go.sum ./dead-letter-controller/

# orchestrator is not dropped: release-controller's go.mod replaces
# agent-remediation with a local directory, and agent-remediation's own
# go.mod in turn replaces orchestrator with a local directory. A `replace`
# directive is only honoured for the main module or a workspace `use` member,
# so orchestrator must stay in `use` for its own replace of state to resolve
# state's go.mod locally instead of fetching a nonexistent published version.
RUN go work edit -dropuse=./state \
    && go work edit -dropuse=./agent-chat \
    && go work edit -dropuse=./execution-controller \
    && go work edit -dropuse=./remediation \
    && go work edit -dropuse=./dead-letter-controller \
    && go work edit -dropuse=./tests/e2e

RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY pkg/ ./pkg/
COPY agent-remediation/ ./agent-remediation/
COPY release-controller/ ./release-controller/

WORKDIR /app/release-controller

# Pre-compile the binary for faster startup in K8s. Build the whole package
# (not `main.go`): package main spans main.go and startup.go, and a single-file
# build omits the siblings.
RUN go build -o /app/release-controller/bin/release-controller .

# announce-topology, the operator command that announces a topology under the
# next promotion seq. The e2e suite and the local benchmark run it in this
# container with `docker exec`, so they need neither S3 nor database access.
RUN go build -o /app/release-controller/bin/announce-topology ./cmd/announce-topology

EXPOSE 8088

CMD ["tail", "-f", "/dev/null"]
