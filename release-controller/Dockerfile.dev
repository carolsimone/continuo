FROM continuo-base:latest

WORKDIR /app

COPY go.work go.work.sum* ./
COPY state/go.mod state/go.sum ./state/
COPY pkg/go.mod pkg/go.sum ./pkg/
COPY orchestrator/go.mod orchestrator/go.sum ./orchestrator/
COPY executor-controller/go.mod executor-controller/go.sum ./executor-controller/
COPY k8s-controller/go.mod k8s-controller/go.sum ./k8s-controller/
COPY release-controller/go.mod release-controller/go.sum ./release-controller/
COPY tests/e2e/go.mod tests/e2e/go.sum ./tests/e2e/

RUN go work edit -dropuse=./state \
    && go work edit -dropuse=./orchestrator \
    && go work edit -dropuse=./executor-controller \
    && go work edit -dropuse=./k8s-controller \
    && go work edit -dropuse=./tests/e2e

RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY pkg/ ./pkg/
COPY release-controller/ ./release-controller/

WORKDIR /app/release-controller

EXPOSE 8088

CMD ["tail", "-f", "/dev/null"]
