{
  "name": "continuo-ui",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "dev": "concurrently \"vite\" \"CHAT_BRIDGE_ENABLED=true AUTH_MODE=dev tsx watch src/server/index.ts\"",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:client && npm run build:server",
    "start": "NODE_ENV=production node dist-server/index.js",
    "test": "vitest run",
    "lint": "eslint src/",
    "fmt": "prettier --write \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@octokit/auth-app": "^8.2.0",
    "@octokit/rest": "^22.0.1",
    "@xyflow/react": "^12.11.2",
    "cookie": "^1.1.1",
    "dagre": "^0.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.1",
    "ioredis": "^5.11.1",
    "openid-client": "^6.8.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/dagre": "^0.7.54",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "jose": "^6.2.4",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^5.3.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
