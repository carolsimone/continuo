# continuo Redis ACL rules: one login per service, generated from pkg/streams/contract.yaml by `go generate ./pkg/streams/...`. Do not edit.
# Each line is a login without a password: add `>password` or `#<sha256>` after `on`. Redis refuses comment lines in an ACL file, so drop these two lines when you load it.
user continuo_agent_chat on ~continuo:agent-chat:ratelimit:* -@all +ping +hello +client|setinfo +xinfo|groups +eval +evalsha +zremrangebyscore +zcard +zadd +pexpire
user continuo_agent_remediation on ~continuo:remediation.requested:v2 %W~continuo:consumer.dead_letter:v1 %W~continuo:outbox.dead_letter:v1 %W~continuo:remediation.pr_closed:v1 %W~continuo:remediation.pr_opened:v1 %W~continuo:remediation.proposed:v1 ~continuo:llmcache:* -@all +ping +hello +client|setinfo +xinfo|groups +xadd +xreadgroup +xack +xautoclaim +xclaim +xpending +xinfo|consumers +xgroup|delconsumer +get +set
user continuo_catalog on ~continuo:release.promoted:v2 ~continuo:remediation.pr_closed:v1 ~continuo:remediation.pr_opened:v1 ~continuo:remediation.requested:v2 %W~continuo:consumer.dead_letter:v1 -@all +ping +hello +client|setinfo +xinfo|groups +xadd +xreadgroup +xack +xautoclaim +xclaim +xpending +xinfo|consumers +xgroup|delconsumer
user continuo_dead_letter_controller on ~continuo:* -@all +ping +hello +client|setinfo +xinfo|groups +xadd +xreadgroup +xack +xautoclaim +xclaim +xpending +xinfo|consumers +xgroup|delconsumer +xrange +xtrim +xlen +del +info
user continuo_execution_controller on ~continuo:compile.requested:v1 ~continuo:pipeline.run.finished:v1 ~continuo:release.promoted:v2 ~continuo:release.rejected:v1 ~continuo:run.cancelled:v1 ~continuo:seed.build.requested:v1 ~continuo:task.dispatch:v1 ~continuo:validation.requested:v1 ~continuo:validation.result:v1 %W~continuo:compile.completed:v1 %W~continuo:consumer.dead_letter:v1 %W~continuo:outbox.dead_letter:v1 %W~continuo:seed.build.completed:v1 %W~continuo:task.status.updated:v2 -@all +ping +hello +client|setinfo +xinfo|groups +xadd +xreadgroup +xack +xautoclaim +xclaim +xpending +xinfo|consumers +xgroup|delconsumer
user continuo_release_controller on ~continuo:compile.completed:v1 ~continuo:manifest.loaded.candidate:v2 ~continuo:seed.build.completed:v1 ~continuo:validation.result:v1 %W~continuo:compile.requested:v1 %W~continuo:consumer.dead_letter:v1 %W~continuo:outbox.dead_letter:v1 %W~continuo:pipeline.run.finished:v1 %W~continuo:release.promoted:v2 %W~continuo:release.rejected:v1 %W~continuo:release.requested:v1 %W~continuo:remediation.retry_requested:v1 %W~continuo:seed.build.requested:v1 %W~continuo:validation.requested:v1 -@all +ping +hello +client|setinfo +xinfo|groups +xadd +xreadgroup +xack +xautoclaim +xclaim +xpending +xinfo|consumers +xgroup|delconsumer
user continuo_remediation on ~continuo:release.rejected:v1 ~continuo:remediation.retry_requested:v1 %W~continuo:consumer.dead_letter:v1 %W~continuo:outbox.dead_letter:v1 %W~continuo:remediation.requested:v2 -@all +ping +hello +client|setinfo +xinfo|groups +xadd +xreadgroup +xack +xautoclaim +xclaim +xpending +xinfo|consumers +xgroup|delconsumer
user continuo_run_controller on ~continuo:release.promoted:v2 ~continuo:task.status.updated:v2 %W~continuo:consumer.dead_letter:v1 %W~continuo:outbox.dead_letter:v1 %W~continuo:run.cancelled:v1 %W~continuo:task.dispatch:v1 -@all +ping +hello +client|setinfo +xinfo|groups +xadd +xreadgroup +xack +xautoclaim +xclaim +xpending +xinfo|consumers +xgroup|delconsumer
user continuo_redis_migrate on ~continuo:* -@all +ping +hello +client|setinfo +xgroup|create +xgroup|destroy +xinfo|groups +exists
user continuo_topology_controller on ~continuo:release.requested:v1 %W~continuo:consumer.dead_letter:v1 %W~continuo:manifest.loaded.candidate:v2 -@all +ping +hello +client|setinfo +xinfo|groups +xadd +xreadgroup +xack +xautoclaim +xclaim +xpending +xinfo|consumers +xgroup|delconsumer
user continuo_ui on ~continuo:uisession:* -@all +ping +hello +client|setinfo +xinfo|groups +get +set +del +expire
