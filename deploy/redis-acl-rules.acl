# continuo Redis ACL rules: one login per component, generated from pkg/streams/contract.yaml by `go generate ./pkg/streams/...`. Do not edit.
# Each line is a login without a password: add `>password` or `#<sha256>` after `on`. Redis refuses comment lines in an ACL file, so drop these two lines when you load it.
user continuo_agent_chat on ~continuo:agent-chat:ratelimit:* -@all +ping +hello +client|setinfo +xinfo|groups +eval +evalsha +zremrangebyscore +zcard +zadd +pexpire
user continuo_agent_remediation on ~continuo:heal.triggered:v1 %W~continuo:consumer.dead_letter:v1 %W~continuo:fix.pr_closed:v1 %W~continuo:fix.pr_opened:v1 %W~continuo:fix.proposed:v1 %W~continuo:outbox.dead_letter:v1 %W~continuo:remediation.handed_over:v1 ~continuo:llmcache:* -@all +ping +hello +client|setinfo +xinfo|groups +xadd +xreadgroup +xack +xautoclaim +xclaim +xpending +xinfo|consumers +xgroup|delconsumer +get +set
user continuo_catalog on ~continuo:fix.pr_closed:v1 ~continuo:fix.pr_opened:v1 ~continuo:heal.triggered:v1 ~continuo:release.promoted:v1 %W~continuo:consumer.dead_letter:v1 -@all +ping +hello +client|setinfo +xinfo|groups +xadd +xreadgroup +xack +xautoclaim +xclaim +xpending +xinfo|consumers +xgroup|delconsumer
user continuo_dead_letter_controller on ~continuo:* -@all +ping +hello +client|setinfo +xinfo|groups +xadd +xreadgroup +xack +xautoclaim +xclaim +xpending +xinfo|consumers +xgroup|delconsumer +xrange +xtrim +xlen +del +info
user continuo_execution_controller on ~continuo:compile.requested:v1 ~continuo:release.promoted:v1 ~continuo:release.rejected:v1 ~continuo:release_check.finished:v1 ~continuo:run.cancelled:v1 ~continuo:seed.build.requested:v1 ~continuo:task.dispatch:v1 ~continuo:validation.requested:v1 ~continuo:validation.result:v1 %W~continuo:compile.completed:v1 %W~continuo:consumer.dead_letter:v1 %W~continuo:outbox.dead_letter:v1 %W~continuo:seed.build.completed:v1 %W~continuo:task.status.updated:v1 -@all +ping +hello +client|setinfo +xinfo|groups +xadd +xreadgroup +xack +xautoclaim +xclaim +xpending +xinfo|consumers +xgroup|delconsumer
user continuo_release_controller on ~continuo:compile.completed:v1 ~continuo:release.parsed:v1 ~continuo:seed.build.completed:v1 ~continuo:validation.result:v1 %W~continuo:compile.requested:v1 %W~continuo:consumer.dead_letter:v1 %W~continuo:outbox.dead_letter:v1 %W~continuo:release.promoted:v1 %W~continuo:release.rejected:v1 %W~continuo:release.requested:v1 %W~continuo:release_check.finished:v1 %W~continuo:round.requested:v1 %W~continuo:seed.build.requested:v1 %W~continuo:validation.requested:v1 -@all +ping +hello +client|setinfo +xinfo|groups +xadd +xreadgroup +xack +xautoclaim +xclaim +xpending +xinfo|consumers +xgroup|delconsumer
user continuo_remediation on ~continuo:release.rejected:v1 ~continuo:round.requested:v1 %W~continuo:consumer.dead_letter:v1 %W~continuo:heal.triggered:v1 %W~continuo:outbox.dead_letter:v1 -@all +ping +hello +client|setinfo +xinfo|groups +xadd +xreadgroup +xack +xautoclaim +xclaim +xpending +xinfo|consumers +xgroup|delconsumer
user continuo_run_controller on ~continuo:release.promoted:v1 ~continuo:task.status.updated:v1 %W~continuo:consumer.dead_letter:v1 %W~continuo:outbox.dead_letter:v1 %W~continuo:run.cancelled:v1 %W~continuo:task.dispatch:v1 -@all +ping +hello +client|setinfo +xinfo|groups +xadd +xreadgroup +xack +xautoclaim +xclaim +xpending +xinfo|consumers +xgroup|delconsumer
user continuo_redis_migrate on ~continuo:* -@all +ping +hello +client|setinfo +xgroup|create +xgroup|destroy +xinfo|groups +exists
user continuo_topology_controller on ~continuo:release.requested:v1 %W~continuo:consumer.dead_letter:v1 %W~continuo:release.parsed:v1 -@all +ping +hello +client|setinfo +xinfo|groups +xadd +xreadgroup +xack +xautoclaim +xclaim +xpending +xinfo|consumers +xgroup|delconsumer
user continuo_ui on ~continuo:uisession:* -@all +ping +hello +client|setinfo +xinfo|groups +get +set +del +expire
