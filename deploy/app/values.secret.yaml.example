global:
  postgres:
    user: runner
    password: changeme

  redis:
    password: changeme

  neo4j:
    user: neo4j
    password: changeme

  s3:
    accessKeyId: changeme
    secretKey: changeme

  auth:
    oidcClientSecret: changeme

  llm:
    # Anthropic (or compatible) API key for agent-runner. Required when
    # CHAT_BRIDGE_ENABLED=true on ui-service; agent-runner boots without it but
    # chat sessions will fail until the key is supplied.
    apiKey: "sk-ant-..."
