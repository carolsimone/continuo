FROM flyway/flyway:13

# The base image runs as root and defines no non-root user. Migrations need no
# privileges: install the tooling as root, hand /flyway (Flyway writes its
# reports into the working directory) to an unprivileged user, then drop to it.
RUN apt-get update \
    && apt-get install -y --no-install-recommends postgresql-client \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 65532 --no-create-home --shell /usr/sbin/nologin migrate

COPY migrate-all.sh /migrate-all.sh
RUN chmod +x /migrate-all.sh

COPY migration/state /flyway/sql/state
COPY migration/executor /flyway/sql/executor
COPY migration/orchestrator /flyway/sql/orchestrator
COPY migration/k8s /flyway/sql/k8s
COPY migration/release /flyway/sql/release
COPY migration/agent_chat /flyway/sql/agent_chat
COPY migration/remediation /flyway/sql/remediation
COPY migration/agent_remediation /flyway/sql/agent_remediation

# Non-recursive: only the /flyway directory entry needs to be group-writable
# so Flyway (WORKDIR /flyway) can create its report files there. Everything
# already copied under /flyway/sql/* is read-only input and stays root-owned.
RUN chown 65532:0 /flyway

USER 65532:65532

ENTRYPOINT ["/bin/sh", "/migrate-all.sh"]
