# Build stage
ARG BASE_IMAGE=ghcr.io/carolsimone/continuo-base:v1
FROM --platform=$BUILDPLATFORM ${BASE_IMAGE} AS builder

# Supplied by buildx: the architecture of the image being produced. The builder
# itself stays on the native build platform and cross-compiles to it.
ARG TARGETARCH

WORKDIR /app

# Copy workspace and all go.mod files (required by go.work)
COPY go.work go.work.sum* ./
COPY run-controller/go.mod run-controller/go.sum ./run-controller/
COPY pkg/go.mod pkg/go.sum ./pkg/
COPY orchestrator/go.mod orchestrator/go.sum ./orchestrator/
COPY execution-controller/go.mod execution-controller/go.sum ./execution-controller/
COPY release-controller/go.mod release-controller/go.sum ./release-controller/
COPY tests/e2e/go.mod tests/e2e/go.sum ./tests/e2e/
COPY agent-chat/go.mod agent-chat/go.sum ./agent-chat/
COPY remediation/go.mod remediation/go.sum ./remediation/
COPY agent-remediation/go.mod agent-remediation/go.sum ./agent-remediation/
COPY dead-letter-controller/go.mod dead-letter-controller/go.sum ./dead-letter-controller/
COPY egress-proxy/go.mod egress-proxy/go.sum ./egress-proxy/

# Download dependencies into an image layer keyed on the go.mod files.
# A source change reuses the layer, and `go build` finds every module in the
# image instead of fetching it again; only a changed go.mod or go.sum
# downloads again.
RUN go mod download

# Copy source code
COPY run-controller/ ./run-controller/
COPY pkg/ ./pkg/

# Build static binary
WORKDIR /app/run-controller
RUN --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux GOARCH=$TARGETARCH go build -a -installsuffix cgo -o /app/bin/run-controller .

# Runtime stage
FROM alpine:latest

RUN apk --no-cache add ca-certificates tzdata

COPY --from=builder /app/bin/run-controller /usr/local/bin/run-controller

EXPOSE 8082 50051

# Static binary; no filesystem writes at runtime — run unprivileged.
USER 65532:65532

CMD ["run-controller"]
