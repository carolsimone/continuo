FROM continuo-base:latest

WORKDIR /app

# Layer 1: Workspace stub. Every go.mod / go.sum is copied so `go mod download`
# can satisfy every dependency go.work cites; only the modules this image
# builds against (pkg, egress-proxy) get their source trees later.
COPY go.work go.work.sum* ./
COPY run-controller/go.mod run-controller/go.sum ./run-controller/
COPY pkg/go.mod pkg/go.sum ./pkg/
COPY orchestrator/go.mod orchestrator/go.sum ./orchestrator/
COPY execution-controller/go.mod execution-controller/go.sum ./execution-controller/
COPY release-controller/go.mod release-controller/go.sum ./release-controller/
COPY agent-chat/go.mod agent-chat/go.sum ./agent-chat/
COPY remediation/go.mod remediation/go.sum ./remediation/
COPY tests/e2e/go.mod tests/e2e/go.sum ./tests/e2e/
COPY agent-remediation/go.mod agent-remediation/go.sum ./agent-remediation/
COPY dead-letter-controller/go.mod dead-letter-controller/go.sum ./dead-letter-controller/
COPY egress-proxy/go.mod egress-proxy/go.sum ./egress-proxy/

# Layer 2: Drop the use-directives of modules this image does not build, so
# `go build` does not need their source trees.
RUN go work edit -dropuse=./run-controller \
    && go work edit -dropuse=./agent-chat \
    && go work edit -dropuse=./orchestrator \
    && go work edit -dropuse=./execution-controller \
    && go work edit -dropuse=./release-controller \
    && go work edit -dropuse=./remediation \
    && go work edit -dropuse=./agent-remediation \
    && go work edit -dropuse=./dead-letter-controller \
    && go work edit -dropuse=./tests/e2e

# Layer 3: Download dependencies into an image layer keyed on the go.mod files.
# A source change reuses the layer, and `go build` finds every module in the
# image instead of fetching it again; only a changed go.mod or go.sum
# downloads again.
RUN go mod download

# Layer 4: Source for the modules this service builds against. pkg/ first
# (lower churn) so a change in egress-proxy/ does not invalidate the pkg layer.
COPY pkg/ ./pkg/
COPY egress-proxy/ ./egress-proxy/

WORKDIR /app/egress-proxy

# Pre-compile the binary for faster startup in docker-compose.
RUN go build -o /app/egress-proxy/bin/egress-proxy .

EXPOSE 3128 8093

CMD ["tail", "-f", "/dev/null"]
