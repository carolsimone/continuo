# Build stage
ARG BASE_IMAGE=ghcr.io/carolsimone/continuo-base:v1
FROM --platform=$BUILDPLATFORM ${BASE_IMAGE} AS builder

# Supplied by buildx: the architecture of the image being produced. The builder
# itself stays on the native build platform and cross-compiles to it.
ARG TARGETARCH

WORKDIR /app

# Copy workspace and all go.mod files (required by go.work)
COPY go.work go.work.sum* ./
COPY state/go.mod state/go.sum ./state/
COPY pkg/go.mod pkg/go.sum ./pkg/
COPY orchestrator/go.mod orchestrator/go.sum ./orchestrator/
COPY executor-controller/go.mod executor-controller/go.sum ./executor-controller/
COPY k8s-controller/go.mod k8s-controller/go.sum ./k8s-controller/
COPY release-controller/go.mod release-controller/go.sum ./release-controller/
COPY agent-runner/go.mod agent-runner/go.sum ./agent-runner/
COPY remediation/go.mod remediation/go.sum ./remediation/
COPY remediation-agent/go.mod remediation-agent/go.sum ./remediation-agent/
COPY tests/e2e/go.mod tests/e2e/go.sum ./tests/e2e/

# Download dependencies with cache
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

# Copy source code — pkg and orchestrator (gRPC stubs) are dependencies
# of remediation-agent and must be present for the build.
COPY pkg/ ./pkg/
COPY orchestrator/ ./orchestrator/
COPY remediation-agent/ ./remediation-agent/

# Build static binary
WORKDIR /app/remediation-agent
RUN --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux GOARCH=$TARGETARCH go build -a -installsuffix cgo -o /app/bin/remediation-agent .

# Runtime stage. Debian slim, not alpine: the packaging toolchain below pulls
# in pyarrow, which ships manylinux wheels only — alpine's musl libc would
# force a source build. continuo-python-runtime declares requires-python
# >= 3.14, which python:3.14-slim satisfies.
FROM python:3.14-slim

# ca-certificates/tzdata carry over from the alpine stage this replaces.
# continuo-python-runtime provides the continuo-runtime CLI the
# ContractPackager adapter shells out to, so a proposed python-node fix is
# packaged by the same tool that packages every promoted release.
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates tzdata \
 && rm -rf /var/lib/apt/lists/* \
 && pip install --no-cache-dir continuo-python-runtime==0.2.0

# Explicit COPY allowlist — only the service binary; new builder artifacts
# are absent from the runtime image unless added here.
COPY --from=builder /app/bin/remediation-agent /usr/local/bin/remediation-agent

EXPOSE 8092

# Static binary; no filesystem writes at runtime — run unprivileged.
USER 65532:65532

CMD ["remediation-agent"]
