FROM python:3.14-slim

# Slim per-engine validation runner: the continuo harness plus exactly ONE engine
# library (trino) installed from PyPI. The engine is baked at build time; the
# executor selects it by choosing this image. No other engine's driver is present.
#
# CONTRACT_VERSION must match the harness pyproject's continuo-validation-contract
# pin — a mismatch fails the second install loudly instead of resolving elsewhere.
ARG CONTRACT_VERSION=0.2.0
ARG TRINO_LIB_VERSION=0.1.1
# CONTINUO_INDEX_URL: optional alternate index used ONLY for the two continuo
# packages, in the separate --no-deps transaction below — never as an
# --extra-index-url on the general install, where pip would consider it for EVERY
# dependency (boto3, trino, transitives) and could resolve any of them from the
# untrusted index (dependency confusion). Normally unset: the continuo packages
# live on real PyPI.
ARG CONTINUO_INDEX_URL=""
COPY . /src/validation-runner
# Two transactions keep the index scopes airtight:
# 1. (only while CONTINUO_INDEX_URL is set) the two continuo packages, pinned,
#    --no-deps, from that index alone — nothing else can come from it.
# 2. everything else (harness + remaining deps) from the default index only; the
#    already-installed continuo pins are seen as satisfied and never re-resolved.
RUN if [ -n "${CONTINUO_INDEX_URL}" ]; then \
        pip install --no-cache-dir --no-deps --index-url "${CONTINUO_INDEX_URL}" \
            "continuo-validation-contract==${CONTRACT_VERSION}" \
            "continuo-validation-trino==${TRINO_LIB_VERSION}"; \
    fi \
    && pip install --no-cache-dir \
        /src/validation-runner "continuo-validation-trino==${TRINO_LIB_VERSION}" \
    && rm -rf /src

# continuo's executor invokes `python /validation_runner.py`.
COPY validation_runner.py /validation_runner.py

RUN useradd --uid 65532 --no-create-home --shell /usr/sbin/nologin nonroot
USER 65532:65532
ENTRYPOINT []
CMD ["python", "/validation_runner.py"]
